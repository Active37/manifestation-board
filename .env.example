NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/manifestation_board
CORS_ORIGINS=
TRUSTED_PROXIES=
IP_HASH_SECRET=replace-with-at-least-32-random-characters
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
POSTS_PER_HOUR=3
LIKES_PER_MINUTE=30
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Required in production; keep the migration role distinct from the runtime role.
# MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@DB_HOST:5432/manifestation_board?sslmode=verify-full
# Production Turnstile settings must match the widget used by the frontend.
# TURNSTILE_EXPECTED_HOSTNAME=board.example.org
# TURNSTILE_EXPECTED_ACTION=create_goal
