{
  "name": "manifestation-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch backend/src/server.ts",
    "build": "tsc -p backend/tsconfig.json",
    "start": "node --env-file=.env build/backend/server.js",
    "db:migrate": "node --env-file=.env --import tsx backend/src/db/migrate.ts",
    "db:verify": "node --env-file=.env --import tsx backend/src/db/verify-schema.ts",
    "admin:bootstrap": "node --env-file=.env --import tsx backend/src/admin/bootstrap.ts",
    "test:api": "node --import tsx --test backend/src/config.test.ts backend/src/posts/captcha.test.ts backend/src/app.test.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
